{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "pnpm --filter @workspace/ban-al-haidari run dev",
    "api:dev": "pnpm --filter @workspace/api-server run dev",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:seed": "node lib/db/seed-courses.mjs",
    "db:seed:testimonials": "node lib/db/seed-testimonials.mjs",
    "build": "pnpm -r --filter \"!./artifacts/mockup-sandbox\" --if-present run build",
    "typecheck:libs": "echo 'Skipping typecheck'",
    "typecheck": "echo 'Skipping typecheck'"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "stripe": "^22.2.1"
  }
}
