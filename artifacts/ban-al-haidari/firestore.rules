rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper ──────────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "ban.alhaideri369@gmail.com";
    }

    function isAuthed() {
      return request.auth != null;
    }

    // ─── User Profiles ────────────────────────────────────────────────────────
    match /user_profiles/{userId} {
      allow read:   if isAuthed() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthed() && request.auth.uid == userId && validProfile();
      allow update: if isAuthed() && request.auth.uid == userId && validProfile();
      allow delete: if false;
    }

    function validProfile() {
      let data = request.resource.data;
      return data.keys().hasAll(["uid", "email"])
          && data.uid == request.auth.uid
          && data.email is string
          && (data.bio       == null || (data.bio       is string && data.bio.size()       <= 500))
          && (data.phone     == null || (data.phone     is string && data.phone.size()     <= 30))
          && (data.intention == null || (data.intention is string && data.intention.size() <= 300));
    }

    // ─── Recorded Courses ─────────────────────────────────────────────────────
    // Admin: full CRUD. Anyone: read only.
    match /recorded_courses/{id} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Online Courses ───────────────────────────────────────────────────────
    // Admin: full CRUD. Anyone: read only.
    match /online_courses/{id} {
      allow read:   if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Bookings ─────────────────────────────────────────────────────────────
    // Any user can create a booking. Admin can read all. Users cannot read others'.
    match /bookings/{id} {
      allow read:   if isAdmin();
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Deny everything else ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
